# --- Server ---
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/app.db
WEB_DIST_PATH=apps/web/dist
ROOM_TTL_HOURS=24
DATA_RETENTION_DAYS=7
PAIRING_WINDOW_MS=1000
# Chỉ nhận WebSocket từ origin này. Quick tunnel đổi URL mỗi lần chạy, nên để trống
# trừ khi dùng domain cố định, ví dụ https://rtk.example.com
PUBLIC_ORIGIN=

# --- Trạm CORS qua NTRIP ---
# RTK2go chạy SNIP. Chọn mountpoint trong sourcetable http://rtk2go.com:2101
# có 1005/1006, MSM (1074-1077, 1094-1097, 1124-1127) và ít nhất một mã quỹ
# đạo 1019, 1046 hoặc 1042. Để trống CORS_NTRIP_HOST thì module CORS tắt.
CORS_NTRIP_HOST=rtk2go.com
CORS_NTRIP_PORT=2101
CORS_NTRIP_MOUNTPOINT=
CORS_NTRIP_USER=
CORS_NTRIP_PASS=none
# 1 = NTRIP 2.0 (HTTP/1.1, chunked);
CORS_NTRIP_V2=0
CORS_MIN_ELEVATION_DEG=10
CORS_HISTORY_EPOCHS=600

# Trạm giả lập thay cho caster: 1, no-ephemeris hoặc no-station. Bật thì bỏ qua
# các biến NTRIP ở trên.
# CORS_MOCK=1
